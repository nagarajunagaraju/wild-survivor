; Engine configuration file.
config_version=5

[application]

config/name="Wild Survivor 3D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"

[display]

window/size/viewport_width=720
window/size/viewport_height=1560
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.8, 1)
